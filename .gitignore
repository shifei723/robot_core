# ============================================================
# robot_core .gitignore  —— 纯代码版本
# 目标：只跟踪源码与必要配置，排除构建产物 / 运行输出 / 大二进制。
# 注意：不使用裸 output/、data/ 规则，避免误伤源码目录
#       (如 nlohmann/detail/output 等第三方头文件)。
# ============================================================

# ---------- ROS2 / colcon 构建产物 ----------
build/
install/
log/
devel/
.catkin_tools/
logs/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ---------- C/C++ 构建中间产物 ----------
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.out
*.lib
*.exe

# ---------- 例外：构建必需的第三方预编译库 ----------
# 这些是厂商/上游只提供二进制的闭源依赖，无法现场编译，
# 随仓库携带以保证 clone 下来即可编译（详见 README「内置二进制依赖」）。
!voice/tts/hobot_tts/wetts/lib/*.so
!voice/tts/hobot_tts/wetts/lib/*.so.*
!voice/tts/tts_cpp/sherpa-onnx-sdk/lib/*.so
!voice/tts/tts_cpp/sherpa-onnx-sdk/lib/*.so.*
!third/lapacke/lib/*.so
!third/lapacke/lib/*.so.*
!third/lapacke/lib/*.a
!voice/kws/**/lib/*.so
!voice/kws/**/lib/*.so.*

# 体积较大的运行期资源（模型 / SDK 命令行工具）已改为 Git LFS 跟踪，
# 见 .gitattributes：随仓库统一拉取，clone 后执行 git lfs pull 取回真实文件。

# ---------- Open3D 预编译版（不入库）----------
# aarch64 576M / x86_64 1.6G，静态库版，超出 Git LFS 免费额度；
# 用 assets/fetch_open3d.sh 从本地副本 / 网盘 / Release 获取。
third/open3d141/
third/open3d141_x86/
CMakeCache.txt
CMakeFiles/
cmake-build-*/
compile_commands.json

# ---------- SLAM / LIO 运行输出 ----------
Log/
PCD/
*.pcd
*.ply
*.pcap
*.bag
*.db3
FAST-Calib-ROS2/output/
FAST-Calib-ROS2/calib_data/

# ---------- 地图 / 模型 / 大二进制 ----------
*.db
*.hbm
*.gguf
*.onnx
*.safetensors
*.pt
*.pth
*.engine
*.tflite
*.bin
*.pb

# 例外：语音 / 多模态模型交给 Git LFS 入库（见 .gitattributes），不再忽略
!voice/**/*.onnx
!voice/**/*.bin
!voice/**/*.hbm
!voice/**/*.gguf
!voice/**/*.pt
!voice/**/*.pth
!data/models/**/*.bin
!data/models/**/*.hbm
!data/models/**/*.gguf
!data/models/**/*.onnx

# ---------- 压缩包 / 分发件 ----------
*.zip
*.tar
*.tar.*
*.tgz
*.whl
*.deb
*.7z

# ---------- 音视频 / 演示媒体 ----------
*.mp4
*.mov
*.avi
*.webm
*.gif
*.wav
*.mp3

# ---------- 文档大文件 ----------
*.pdf

# ---------- IDE / 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- 其他运行时 ----------
*.log
# 注意：不要用裸 "core"，它会把同名源码目录一起忽略掉，
# 例如 localization/visual_slam/rtabmap/corelib/include/rtabmap/core/
# （当时就是这样把 rtabmap 全部公共头文件排除出版本库的）。
/core
*.core

# ---------- 构建必需、随仓库携带的第三方预编译库(显式白名单, 覆盖上面的 *.a/*.so) ----------
# 这些是 unitree_lidar 等包链接所需的预编译库, 缺失则新机器 clone 后编译失败。
!sensors/lidar/unitree_lidar/unitree_lidar_sdk/lib/aarch64/libunilidar_sdk2.a
!sensors/lidar/unitree_lidar/unitree_lidar_sdk/lib/x86_64/libunilidar_sdk2.a
